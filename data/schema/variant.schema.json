{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "variant.schema.json",
  "title": "AI Model Explorer — Variant",
  "description": "单个模型型号的数据契约。复用现有字段 data_source / last_verified_at / source_url；仅新增可选字段 last_checked_at（机器自动检查时间）。additionalProperties 允许，保证 V4 数据兼容、无大迁移。",
  "type": "object",
  "required": ["id", "provider_id", "name", "name_cn"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "family_id": { "type": "string" },
    "provider_id": { "type": "string" },
    "name": { "type": "string" },
    "name_cn": { "type": "string" },
    "model_id": { "type": "string" },
    "one_liner_cn": { "type": "string" },
    "context_window": { "type": ["integer", "null"] },
    "max_output_tokens": { "type": ["integer", "null"] },
    "input_price_per_mtok": { "type": ["number", "null"] },
    "output_price_per_mtok": { "type": ["number", "null"] },
    "currency": { "type": "string", "enum": ["USD", "CNY"] },
    "vision_support": { "type": "boolean" },
    "open_weight": { "type": "boolean" },
    "speed_tier": { "type": "string", "enum": ["fast", "faster", "fastest", "slow", "slower", "moderate", "medium"] },
    "model_type": { "type": "array", "items": { "type": "string", "enum": ["Chat", "Vision", "Reasoning", "Coding", "Agent", "Image", "Video", "Transcription"] } },
    "capabilities": { "type": "object", "additionalProperties": true },
    "best_for": { "type": "array", "items": { "type": "string" } },
    "avoid_for": { "type": "array", "items": { "type": "string" } },
    "release_date": { "type": "string" },
    "source_url": { "type": "string" },
    "verified": { "type": "boolean" },
    "verified_date": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "cost_tier": { "type": "string", "enum": ["production", "cost_effective", "free"] },
    "role": { "type": "string" },
    "access_types": { "type": "array", "items": { "type": "string", "enum": ["official_api", "open_source", "self_host", "free_api"] } },
    "status": { "type": "string", "enum": ["active", "archived"] },
    "data_quality_score": { "type": ["integer", "null"] },
    "data_source": { "type": "string", "enum": ["official", "community"] },
    "last_verified_at": { "type": "string" },
    "price_model": { "type": "string", "enum": ["per_token", "per_image", "per_second"] },
    "benchmarks": { "type": "array" },
    "media_pricing": { "type": "object", "additionalProperties": true },
    "media_type": { "type": "string", "enum": ["image", "video"] },
    "free": { "type": "boolean" },
    "free_note": { "type": "string" },
    "repo_url": { "type": "string" },
    "last_checked_at": { "type": "string", "description": "机器自动检查时间（Phase 1 Collector 写入），与人工确认的 last_verified_at 语义分离" }
  }
}
